<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expense_Date_Before_Travel_Start</fullName>
    <active>true</active>
    <errorConditionFormula>Expense_Date__c &lt; Travel_Request__r.Start_Date__c</errorConditionFormula>
    <errorDisplayField>Expense_Date__c</errorDisplayField>
    <errorMessage>Expense Date cannot be before the Travel Start Date.</errorMessage>
</ValidationRule>
