<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Expense_Date_After_Travel_End</fullName>
    <active>true</active>
    <errorConditionFormula>Expense_Date__c &gt; Travel_Request__r.End_Date__c</errorConditionFormula>
    <errorDisplayField>Expense_Date__c</errorDisplayField>
    <errorMessage>Expense Date cannot be after the Travel End Date.</errorMessage>
</ValidationRule>
